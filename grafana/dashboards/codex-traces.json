  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["codex", "otel", "traces", "tempo"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "codex.*", "value": "codex.*" },
        "hide": 0,
        "label": "Service",
        "name": "service",
        "options": [
          { "selected": true, "text": "codex.*", "value": "codex.*" },
          { "selected": false, "text": ".+", "value": ".+" },
          { "selected": false, "text": "codex-app-server", "value": "codex-app-server" },
          { "selected": false, "text": "codex-exec-server", "value": "codex-exec-server" }
        ],
        "query": "codex.*,.+,codex-app-server,codex-exec-server",
        "type": "custom"
      }
    ]
